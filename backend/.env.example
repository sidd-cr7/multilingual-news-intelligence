# Copy to backend/.env; keep credentials private. Never expose them to the frontend.
GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=1
GROQ_MAX_INPUT_CHARS=30000
GROQ_CACHE_TTL_SECONDS=1800
GROQ_CACHE_MAX_ENTRIES=128
# Optional reviewed Telugu NER checkpoint; local cache files are still required.
NER_MODEL_ID_TE=
