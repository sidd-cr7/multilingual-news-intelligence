# Backend settings
APP_ENV=development
MAX_UPLOAD_BYTES=10485760
MAX_TEXT_CHARS=100000
MIN_TEXT_CHARS=40
HTTP_TIMEOUT_SECONDS=10
MAX_URL_RESPONSE_BYTES=5242880
MAX_REDIRECTS=3
CORS_ORIGINS=http://localhost:3000
# Optional: path to a downloaded fastText lid.176.bin model. The fallback detector works without it.
FASTTEXT_MODEL_PATH=

